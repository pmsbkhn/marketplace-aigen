<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>vn.marketplace</groupId>
		<artifactId>checkout</artifactId>
		<version>1.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>vn.marketplace.checkout</groupId>
	<artifactId>checkout-service</artifactId>
	<version>1.0-SNAPSHOT</version>
	<name>checkout-service</name>
	<description>checkout-service</description>

	<properties>
		<app.main-class>vn.marketplace.checkout.adapter.CheckoutServiceApplication</app.main-class>
	</properties>

	<!-- Stateless orchestrator: NO JPA, NO database, NO outbox/Kafka — REST in, REST/gRPC out,
	     short-lived session store only (Redis in production, in-memory stand-in standalone). -->
	<dependencies>
		<dependency>
			<groupId>vn.marketplace.checkout</groupId>
			<artifactId>checkout-domain</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>vn.marketplace.checkout</groupId>
			<artifactId>checkout-application</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency>
		<!-- GlobalExceptionHandler + CommonHttpResponse -->
		<dependency>
			<groupId>tech.vsf.ptnt.msfw</groupId>
			<artifactId>spring-adapter-core</artifactId>
			<version>${msfw.version}</version>
		</dependency>

		<!-- Spring Boot / Cloud -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-bootstrap</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- /actuator/prometheus for the msfw observability pack (deploy/observability). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>tech.vsf.ea</groupId>
			<artifactId>ea-archrules</artifactId>
			<version>0.3.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- only for the (vacuous-but-armed) @EventPublishHandler fitness rule -->
			<groupId>tech.vsf.ptnt.msfw</groupId>
			<artifactId>event-core</artifactId>
			<version>${msfw.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>${app.main-class}</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
